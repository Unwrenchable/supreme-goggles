# WalletConnect Configuration
# Get your project ID from https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Smart Contract Configuration (Optional - uses mock data if not set)
# Deploy your contract and add the address here
NEXT_PUBLIC_CONTRACT_ADDRESS=your_contract_address_here

# Network Configuration (Optional - defaults to mainnet)
# Options: mainnet, sepolia, goerli, polygon, arbitrum, optimism, etc.
NEXT_PUBLIC_NETWORK=mainnet
