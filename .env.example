# ===================================================================
# AtomicFizzCaps Universal Naming Service - Environment Configuration
# ===================================================================
# Copy this file to .env.local and fill in your values

# ===================================================================
# REQUIRED: WalletConnect Configuration
# ===================================================================
# Get your free project ID from https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# ===================================================================
# MODE: Demo vs Production
# ===================================================================
# false = Demo mode with mock data (no blockchain needed)
# true = Production mode with real blockchain transactions
NEXT_PUBLIC_USE_PRODUCTION_MODE=false

# ===================================================================
# SOLANA CONFIGURATION
# ===================================================================
# Network: devnet (default/testing), testnet, or mainnet-beta (production)
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Your deployed Solana program address (for production)
NEXT_PUBLIC_SOLANA_CONTRACT_ADDRESS=

# Your Solana wallet address for receiving payments
NEXT_PUBLIC_SOLANA_PAYMENT_ADDRESS=

# Optional: Custom RPC endpoint (leave empty to use public endpoints)
NEXT_PUBLIC_SOLANA_RPC_ENDPOINT=

# ===================================================================
# EVM CHAIN CONFIGURATIONS
# ===================================================================
# Deploy DomainRegistry contract to each chain you want to support
# Add the deployed contract address for each chain below

# Ethereum Mainnet
NEXT_PUBLIC_ETHEREUM_CONTRACT_ADDRESS=

# Polygon
NEXT_PUBLIC_POLYGON_CONTRACT_ADDRESS=

# Binance Smart Chain
NEXT_PUBLIC_BSC_CONTRACT_ADDRESS=

# Arbitrum
NEXT_PUBLIC_ARBITRUM_CONTRACT_ADDRESS=

# Optimism
NEXT_PUBLIC_OPTIMISM_CONTRACT_ADDRESS=

# Base
NEXT_PUBLIC_BASE_CONTRACT_ADDRESS=

# Avalanche
NEXT_PUBLIC_AVALANCHE_CONTRACT_ADDRESS=

# Fantom
NEXT_PUBLIC_FANTOM_CONTRACT_ADDRESS=

# Sepolia Testnet (for testing)
NEXT_PUBLIC_SEPOLIA_CONTRACT_ADDRESS=

# ===================================================================
# PAYMENT CONFIGURATION
# ===================================================================
# Your EVM wallet address for receiving payments from EVM chains
NEXT_PUBLIC_PAYMENT_RECIPIENT_ADDRESS=

# Optional: Multi-sig treasury address (recommended for production)
NEXT_PUBLIC_TREASURY_ADDRESS=

# ===================================================================
# NETWORK DEFAULTS
# ===================================================================
# Default network if not specified by domain extension
NEXT_PUBLIC_DEFAULT_NETWORK=mainnet

# ===================================================================
# NOTES
# ===================================================================
# - All variables use NEXT_PUBLIC_ prefix (Next.js requirement for client-side access)
# - Never put private keys or secrets in these variables
# - These values are exposed to the browser
# - For demo mode, only NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID is required
# - For production, configure all contract addresses and payment recipients

# ==================================================
# CONTRACT DEPLOYMENT CONFIGURATION
# ==================================================

# Your deployer private key (NEVER commit this!)
PRIVATE_KEY=

# Treasury address - where all payments are sent
TREASURY_ADDRESS=

# Registration fee in wei (0 for free registration)
# Example: 5000000000000000 = 0.005 ETH
REGISTRATION_FEE=0

# RPC URLs (optional - defaults provided in hardhat.config.ts)
POLYGON_RPC_URL=
BSC_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
BASE_RPC_URL=
AVALANCHE_RPC_URL=
ETHEREUM_RPC_URL=
SEPOLIA_RPC_URL=
MUMBAI_RPC_URL=
BSC_TESTNET_RPC_URL=

# Block explorer API keys (for contract verification)
ETHERSCAN_API_KEY=
POLYGONSCAN_API_KEY=
BSCSCAN_API_KEY=
ARBISCAN_API_KEY=
OPTIMISM_API_KEY=
SNOWTRACE_API_KEY=
FTMSCAN_API_KEY=

# Gas reporting (optional)
REPORT_GAS=false
COINMARKETCAP_API_KEY=
 
