# WalletConnect Configuration
# Get your project ID from https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# ===================================================================
# PRODUCTION MODE CONFIGURATION
# ===================================================================
# Set USE_PRODUCTION_MODE=true to enable real blockchain transactions
# Set to false or leave empty to use demo mode with mock data
NEXT_PUBLIC_USE_PRODUCTION_MODE=false

# ===================================================================
# SMART CONTRACT ADDRESSES (One per blockchain network)
# ===================================================================
# Deploy the DomainRegistry contract to each blockchain you want to support
# See contracts/DomainRegistryExample.sol for the contract code

# Ethereum Mainnet & L2s (ETH-based chains)
NEXT_PUBLIC_ETHEREUM_CONTRACT_ADDRESS=
NEXT_PUBLIC_ARBITRUM_CONTRACT_ADDRESS=
NEXT_PUBLIC_OPTIMISM_CONTRACT_ADDRESS=
NEXT_PUBLIC_BASE_CONTRACT_ADDRESS=

# Other EVM Chains
NEXT_PUBLIC_POLYGON_CONTRACT_ADDRESS=
NEXT_PUBLIC_BSC_CONTRACT_ADDRESS=
NEXT_PUBLIC_AVALANCHE_CONTRACT_ADDRESS=
NEXT_PUBLIC_FANTOM_CONTRACT_ADDRESS=

# Testnet Contracts (for testing before mainnet deployment)
NEXT_PUBLIC_SEPOLIA_CONTRACT_ADDRESS=

# Solana (for .fizz, .atomic, .sol domains)
NEXT_PUBLIC_SOLANA_CONTRACT_ADDRESS=
NEXT_PUBLIC_SOLANA_NETWORK=devnet  # devnet, testnet, or mainnet-beta

# ===================================================================
# PAYMENT COLLECTION CONFIGURATION
# ===================================================================
# IMPORTANT: This is YOUR wallet address where payments are sent
# When users register domains, the smart contract sends payments to this address

# EVM Chains Payment Recipient (Ethereum, BSC, Polygon, etc.)
NEXT_PUBLIC_PAYMENT_RECIPIENT_ADDRESS=your_wallet_address_here

# Solana Payment Recipient (for Solana-based domains)
NEXT_PUBLIC_SOLANA_PAYMENT_ADDRESS=your_solana_wallet_address_here

# Treasury/Multi-sig wallet (RECOMMENDED for production)
# For better security, use a multi-signature wallet address
# Examples: Gnosis Safe, multi-sig contract
NEXT_PUBLIC_TREASURY_ADDRESS=your_multisig_wallet_address_here

# ===================================================================
# NETWORK CONFIGURATION
# ===================================================================
# Default network to connect to (used if not specified by extension)
NEXT_PUBLIC_DEFAULT_NETWORK=mainnet
